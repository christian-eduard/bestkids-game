#!/usr/bin/expect -f

set timeout 600
set password "k6kdDfT8"
set host "217.154.191.3"
set user "root"
set project_path "/opt/bestkids-game"

# 1. Upload Inventory Page
puts "Uploading inventory page..."
spawn scp -o StrictHostKeyChecking=no frontend/src/app/dashboard/inventory/page.tsx $user@$host:$project_path/frontend/src/app/dashboard/inventory/page.tsx
expect "password:"
send "$password\r"
expect eof

# 2. Execute
puts "Connecting to remote..."
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$password\r"
expect "#"

send "cd $project_path\r"
expect "#"

puts "Rebuilding frontend..."
send "docker-compose -f docker-compose.prod.yml build frontend\r"
expect "#"

puts "Restarting frontend..."
send "docker-compose -f docker-compose.prod.yml up -d frontend\r"
expect "#"

send "exit\r"
expect eof
puts "Deployment Complete - Inventory page updated!"
