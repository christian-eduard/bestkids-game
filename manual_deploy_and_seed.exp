#!/usr/bin/expect -f
set timeout 900
set password "k6kdDfT8"

# 1. Update Code & Rebuild Backend (to apply Entity changes)
spawn ssh -o StrictHostKeyChecking=no root@217.154.191.3 "cd /opt/bestkids-game && git pull && docker-compose -f docker-compose.prod.yml build backend && docker-compose -f docker-compose.prod.yml up -d && sleep 40"
expect {
  "assword:" {
    send "$password\r"
    exp_continue
  }
  eof
}

# 2. Run Seed
spawn ssh -o StrictHostKeyChecking=no root@217.154.191.3 "cd /opt/bestkids-game && cat demo-seed.sql | docker-compose -f docker-compose.prod.yml exec -T postgres psql -U bestkids_user -d bestkids_db"
expect {
  "assword:" {
    send "$password\r"
    exp_continue
  }
  eof
}

catch wait result
exit [lindex $result 3]
