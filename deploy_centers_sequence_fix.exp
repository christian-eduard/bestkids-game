#!/usr/bin/expect -f

set timeout 60
set password "k6kdDfT8"
set host "217.154.191.3"
set user "root"
set project_path "/opt/bestkids-game"

# Upload fix
puts "Uploading sequence fix..."
spawn scp -o StrictHostKeyChecking=no fix_centers_sequence.sql $user@$host:$project_path/fix_centers_sequence.sql
expect "password:"
send "$password\r"
expect eof

# Execute
puts "Connecting to remote..."
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$password\r"
expect "#"

send "cd $project_path\r"
expect "#"

puts "Copying fix into container..."
send "docker cp fix_centers_sequence.sql bestkids_postgres_prod:/tmp/fix_centers_sequence.sql\r"
expect "#"

puts "Executing sequence fix..."
send "docker-compose -f docker-compose.prod.yml exec -T postgres psql -U bestkids_user -d bestkids_db -f /tmp/fix_centers_sequence.sql\r"
expect "#"

send "exit\r"
expect eof
puts "Sequence fix applied successfully!"
