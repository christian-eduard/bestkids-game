# ===================================
# BESTKIDS - VARIABLES DE ENTORNO
# ===================================

# ===================================
# DATABASE (PostgreSQL)
# ===================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bestkids_db
DATABASE_USER=bestkids_user
DATABASE_PASSWORD=bestkids_password_2024
DATABASE_URL=postgresql://bestkids_user:bestkids_password_2024@localhost:5432/bestkids_db

# ===================================
# BACKEND (NestJS)
# ===================================
BACKEND_PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# ===================================
# FRONTEND (Next.js)
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=BestKids
NEXT_PUBLIC_APP_VERSION=2.0.0

# ===================================
# REDIS (opcional)
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===================================
# EMAIL (opcional, para notificaciones)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bestkids.com

# ===================================
# STORAGE (opcional, para archivos)
# ===================================
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# ===================================
# ANALYTICS (opcional)
# ===================================
# GOOGLE_ANALYTICS_ID=
# SENTRY_DSN=

# ===================================
# PLESK (producción)
# ===================================
