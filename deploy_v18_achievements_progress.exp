#!/usr/bin/expect -f

set timeout 600
set password "k6kdDfT8"
set host "217.154.191.3"
set user "root"
set project_path "/opt/bestkids-game"

# 1. Upload Files
puts "Uploading progress page and nuclear seed..."
spawn scp -o StrictHostKeyChecking=no frontend/src/app/dashboard/progress/page.tsx $user@$host:$project_path/frontend/src/app/dashboard/progress/page.tsx
expect "password:"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no nuclear-seed.sql $user@$host:$project_path/nuclear-seed.sql
expect "password:"
send "$password\r"
expect eof

# 2. Execute
puts "Connecting to remote..."
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$password\r"
expect "#"

send "cd $project_path\r"
expect "#"

puts "Copying seed into container..."
send "docker cp nuclear-seed.sql bestkids_postgres_prod:/tmp/nuclear-seed.sql\r"
expect "#"

puts "Executing nuclear-seed.sql v18 (achievements)..."
send "docker-compose -f docker-compose.prod.yml exec -T postgres psql -U bestkids_user -d bestkids_db -f /tmp/nuclear-seed.sql\r"
expect "#"

puts "Rebuilding frontend..."
send "docker-compose -f docker-compose.prod.yml build frontend\r"
expect "#"

puts "Restarting frontend..."
send "docker-compose -f docker-compose.prod.yml up -d frontend\r"
expect "#"

send "exit\r"
expect eof
puts "Deployment Complete - Achievements and teacher progress deployed!"
